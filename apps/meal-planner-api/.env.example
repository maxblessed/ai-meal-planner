# Copy to apps/meal-planner-api/.env (git-ignored) and fill in real values. Never commit secrets.
# `nx serve` loads .env / .env.local from this folder automatically. The built bundle (dist/main.js, Lambda)
# does NOT read any file: provide real environment variables there.

# MongoDB Atlas connection string (create a database user with access to ONE database only).
MONGODB_URI=
# Required. Always set explicitly: the API never falls back to the database named in the URI.
MONGODB_DB_NAME=meal_planner

# Local development without MongoDB: stores plans in memory (lost on restart). Refused in production.
# USE_IN_MEMORY_REPOSITORY=true

# Comma-separated browser origins allowed by CORS (scheme + host + port, no trailing slash).
# Outside production any localhost / 127.0.0.1 port is always allowed (Expo web may not use 8081), so this list is only
# needed for other origins, e.g. http://192.168.1.20:8081 when opening Expo web from another device.
# Production allows ONLY the origins listed here. Unset in development = all origins.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# development | test | production
NODE_ENV=development

# Authentication. JWT_SECRET signs access tokens: required, at least 32 random characters, never committed.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Define it ONCE: a duplicate key silently makes one of the values win.
JWT_SECRET=
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# Per-instance brute-force limiter on login/register/refresh. Set to false only for load tests.
# AUTH_RATE_LIMIT=true

LOG_LEVEL=info
PORT=3000
HOST=localhost
